#!/usr/bin/env bash
# Yadm bootstrap script - runs after cloning dotfiles

set -e

echo "🚀 Starting yadm bootstrap..."

# Create necessary directories
echo "📁 Creating required directories..."
mkdir -p ~/.config
mkdir -p ~/.local/bin
# macOS-only; harmless no-op elsewhere (used by install-daily-maintenance.sh).
mkdir -p ~/Library/LaunchAgents

# Normalise PATH for this script. Bootstrap runs from `yadm clone` in a
# non-interactive shell that has NOT sourced the freshly-installed .zshrc,
# so ~/.cargo/bin and /opt/homebrew/bin may be absent. Without this every
# `command -v` guard below reads as "not installed" and re-runs a full
# cargo rebuild of tools that are already present — the single biggest
# re-run cost. Order mirrors the .zshrc priority; missing dirs are inert.
export PATH="/opt/homebrew/bin:$HOME/.local/bin:$HOME/.cargo/bin:$PATH"

# Fetch a URL to a path without destroying the existing copy on failure.
# `curl -o` truncates its target before the transfer starts, so a network
# blip or a 404 (upstream theme repos do move files) would replace a good
# theme with an empty file or an HTML error page — a re-run leaving the
# machine worse than before. Download to a temp file and keep it only if
# curl reports success. A successful re-run always refetches (a few KB)
# and overwrites with identical content.
fetch_to() {
    local dest="$1" url="$2" tmp
    tmp="$(mktemp "${TMPDIR:-/tmp}/bootstrap-fetch.XXXXXX")" || return 1
    if curl --fail --silent --show-error --location -o "$tmp" "$url"; then
        chmod 0644 "$tmp"
        # -f so the replace cannot turn into a y/n prompt under a shell
        # that aliases mv to `mv -i`.
        mv -f "$tmp" "$dest"
    else
        rm -f "$tmp"
        return 1
    fi
}

# Setup Ghostty configuration symlink
echo "👻 Setting up Ghostty configuration..."
if [ -f "$HOME/.config/ghostty/config" ]; then
    GHOSTTY_APP_CONFIG="$HOME/Library/Application Support/com.mitchellh.ghostty"

    # Create Ghostty app config directory if it doesn't exist
    mkdir -p "$GHOSTTY_APP_CONFIG"

    # Remove existing config if it's not a symlink
    if [ -f "$GHOSTTY_APP_CONFIG/config" ] && [ ! -L "$GHOSTTY_APP_CONFIG/config" ]; then
        echo "  Backing up existing Ghostty config..."
        mv "$GHOSTTY_APP_CONFIG/config" "$GHOSTTY_APP_CONFIG/config.backup.$(date +%s)"
    fi

    # Create/retarget symlink. -n so an existing symlink is replaced rather
    # than dereferenced, and we retarget a symlink that points elsewhere
    # instead of reporting "already exists" for a wrong link.
    if [ "$(readlink "$GHOSTTY_APP_CONFIG/config" 2>/dev/null)" = "$HOME/.config/ghostty/config" ]; then
        echo "  Ghostty symlink already correct"
    else
        echo "  Creating symlink for Ghostty config..."
        ln -sfn "$HOME/.config/ghostty/config" "$GHOSTTY_APP_CONFIG/config"
    fi

    # Create symlink for shaders directory if it exists
    if [ -d "$HOME/.config/ghostty/shaders" ]; then
        if [ "$(readlink "$GHOSTTY_APP_CONFIG/shaders" 2>/dev/null)" = "$HOME/.config/ghostty/shaders" ]; then
            echo "  Ghostty shaders symlink already correct"
        else
            # A REAL directory here would make `ln -s` drop the link *inside*
            # it (…/shaders/shaders). Move it aside first, then link with -n.
            if [ -d "$GHOSTTY_APP_CONFIG/shaders" ] && [ ! -L "$GHOSTTY_APP_CONFIG/shaders" ]; then
                echo "  Backing up existing Ghostty shaders directory..."
                mv "$GHOSTTY_APP_CONFIG/shaders" "$GHOSTTY_APP_CONFIG/shaders.backup.$(date +%s)"
            fi
            echo "  Creating symlink for Ghostty shaders..."
            ln -sfn "$HOME/.config/ghostty/shaders" "$GHOSTTY_APP_CONFIG/shaders"
        fi
    fi
else
    echo "  Warning: Ghostty config not found in ~/.config/ghostty/"
fi

# Install Homebrew if not present
if ! command -v brew &> /dev/null; then
    echo "🍺 Installing Homebrew..."
    # NONINTERACTIVE=1 is required: bootstrap runs unattended from
    # `yadm clone`, and the installer otherwise blocks on "Press RETURN".
    NONINTERACTIVE=1 /bin/bash -c \
        "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)" \
        || echo "  ⚠️  Homebrew install failed — brew-dependent steps will be skipped"

    # Add Homebrew to PATH for Apple Silicon
    if [ -f "/opt/homebrew/bin/brew" ]; then
        eval "$(/opt/homebrew/bin/brew shellenv)"
    fi
fi

# Install Brewfile packages
if [ -f "$HOME/Brewfile" ] && command -v brew &> /dev/null; then
    echo "📦 Installing Brewfile packages..."
    echo "  Note: Some casks may require sudo password. Run 'brew bundle' manually if needed."
    brew bundle --file="$HOME/Brewfile" || true
fi

# Install mise-managed runtimes defined in ~/.config/mise/config.toml
# (node, python, ruby, go). Without this step, `mise ls` shows "(missing)"
# on a fresh clone and userland falls back to brew's runtimes only.
if command -v mise &> /dev/null; then
    echo "🧰 Installing mise-managed runtimes..."
    mise install || echo "  ⚠️  Some mise runtimes failed to install"
else
    echo "  ⚠️  mise not found, skipping runtime install"
fi

# Install tree-sitter-cli (required for nvim-treesitter main branch)
# Note: Homebrew's tree-sitter is just a library, not the CLI
if command -v cargo &> /dev/null; then
    if ! command -v tree-sitter &> /dev/null; then
        echo "🌳 Installing tree-sitter-cli via cargo..."
        cargo install --locked tree-sitter-cli || echo "  ⚠️  Failed to install tree-sitter-cli"
    else
        echo "🌳 tree-sitter-cli already installed"
    fi
else
    echo "  ⚠️  cargo not found, skipping tree-sitter-cli installation"
    echo "     Run 'cargo install --locked tree-sitter-cli' manually after installing Rust"
fi

# Install pay-respects (command correction, the "fk" alias in .zshrc).
# cargo-only: not packaged in Homebrew, so brew bundle can't cover it.
if command -v cargo &> /dev/null; then
    if ! command -v pay-respects &> /dev/null; then
        echo "🙏 Installing pay-respects via cargo..."
        cargo install --locked pay-respects || echo "  ⚠️  Failed to install pay-respects"
    else
        echo "🙏 pay-respects already installed"
    fi
else
    echo "  ⚠️  cargo not found, skipping pay-respects installation"
    echo "     Run 'cargo install --locked pay-respects' manually (powers the fk alias)"
fi

# Install bob (Neovim version manager) from git dev branch.
# We intentionally track upstream dev instead of Homebrew or crates.io:
# the dev branch contains the nvim proxy permission fix (issue #241) that
# hasn't shipped in any tagged release yet. The daily maintenance script
# keeps bob in sync with dev via SHA-cached cargo rebuilds.
if command -v cargo &> /dev/null; then
    if [ ! -x "$HOME/.cargo/bin/bob" ]; then
        echo "🤖 Installing bob from MordechaiHadad/bob dev branch..."
        cargo install --git https://github.com/MordechaiHadad/bob \
            --branch dev --locked \
            || echo "  ⚠️  Failed to install bob"
        # Seed the SHA cache so the first maintenance run is a no-op.
        # Test the binary path directly — `command -v bob` can miss a
        # just-installed binary if this shell's PATH was captured earlier.
        if [ -x "$HOME/.cargo/bin/bob" ]; then
            mkdir -p "$HOME/.cache/dotfiles"
            git ls-remote https://github.com/MordechaiHadad/bob.git refs/heads/dev \
                2>/dev/null | awk '{print $1}' > "$HOME/.cache/dotfiles/bob-dev-sha" \
                || rm -f "$HOME/.cache/dotfiles/bob-dev-sha"
        fi
    else
        echo "🤖 bob already installed at ~/.cargo/bin/bob"
    fi
else
    echo "  ⚠️  cargo not found, skipping bob installation"
fi

# Setup tmux plugin manager. Anonymous HTTPS clone of a public repo is the
# documented first-clone path and works without any credential helper.
if [ ! -d "$HOME/.tmux/plugins/tpm" ]; then
    echo "🔌 Installing tmux plugin manager..."
    git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm \
        || echo "  ⚠️  Failed to clone tpm"
else
    echo "🔌 tmux plugin manager already installed"
fi

# Install tmux plugins automatically (TPM skips already-cloned plugins)
echo "📦 Installing tmux plugins..."
if [ -x "$HOME/.tmux/plugins/tpm/bin/install_plugins" ]; then
    "$HOME/.tmux/plugins/tpm/bin/install_plugins" \
        || echo "  ⚠️  Some tmux plugins failed; run 'Ctrl-A + I' inside tmux"
else
    echo "  Note: Run 'Ctrl-A + I' inside tmux to install plugins"
fi

# Install Zinit if not present
if [ ! -d "$HOME/.local/share/zinit/zinit.git" ]; then
    echo "⚡ Installing Zinit..."
    bash -c "$(curl --fail --show-error --silent --location https://raw.githubusercontent.com/zdharma-continuum/zinit/HEAD/scripts/install.sh)" \
        || echo "  ⚠️  Failed to install Zinit"
else
    echo "⚡ Zinit already installed"
fi

# Clear zinit snippet cache to ensure fresh state (prevents OMZ loading issues)
echo "🧹 Clearing zinit snippet cache..."
rm -rf "$HOME/.local/share/zinit/snippets/OMZ"* "$HOME/.zcompdump"* 2>/dev/null || true

# Install/Update Catppuccin themes (always fetch latest)
echo "🎨 Installing/Updating Catppuccin themes..."

# FZF Catppuccin theme
echo "  Downloading FZF Catppuccin Mocha theme..."
mkdir -p ~/.config/fzf
fetch_to ~/.config/fzf/catppuccin-mocha.sh \
    https://raw.githubusercontent.com/catppuccin/fzf/main/themes/catppuccin-fzf-mocha.sh || \
    echo "    ⚠️  Failed to download FZF theme (existing copy kept)"

# Bat Catppuccin theme
echo "  Downloading Bat Catppuccin Mocha theme..."
BAT_CONFIG_DIR="$(bat --config-dir 2>/dev/null || echo "$HOME/.config/bat")"
BAT_THEME_DIR="$BAT_CONFIG_DIR/themes"
mkdir -p "$BAT_THEME_DIR"
# Create syntaxes directory to avoid warning
mkdir -p "$BAT_CONFIG_DIR/syntaxes"
fetch_to "$BAT_THEME_DIR/Catppuccin Mocha.tmTheme" \
    "https://github.com/catppuccin/bat/raw/main/themes/Catppuccin%20Mocha.tmTheme" || \
    echo "    ⚠️  Failed to download Bat theme (existing copy kept)"
# Rebuild bat cache AFTER the theme lands, otherwise ~/.config/bat/config's
# --theme="Catppuccin Mocha" resolves to nothing. Must stay in this order.
if command -v bat &> /dev/null; then
    bat cache --build >/dev/null 2>&1 || echo "    ⚠️  Failed to rebuild bat cache"
fi

# Delta Catppuccin theme
echo "  Downloading Delta Catppuccin theme..."
mkdir -p ~/.config/delta
fetch_to ~/.config/delta/catppuccin.gitconfig \
    https://raw.githubusercontent.com/catppuccin/delta/main/catppuccin.gitconfig || \
    echo "    ⚠️  Failed to download Delta theme (existing copy kept)"

# Eza Catppuccin theme (for macOS)
echo "  Downloading Eza Catppuccin Mocha theme..."
if [[ "$OSTYPE" == "darwin"* ]]; then
    EZA_CONFIG="$HOME/Library/Application Support/eza"
else
    EZA_CONFIG="$HOME/.config/eza"
fi
mkdir -p "$EZA_CONFIG"
fetch_to "$EZA_CONFIG/theme.yml" \
    https://raw.githubusercontent.com/catppuccin/eza/main/themes/mocha/catppuccin-mocha-mauve.yml || \
    echo "    ⚠️  Failed to download Eza theme (existing copy kept)"

# Atuin Catppuccin theme
echo "  Downloading Atuin Catppuccin Mocha theme..."
mkdir -p ~/.config/atuin/themes
fetch_to ~/.config/atuin/themes/catppuccin-mocha-blue.toml \
    https://raw.githubusercontent.com/catppuccin/atuin/main/themes/mocha/catppuccin-mocha-blue.toml || \
    echo "    ⚠️  Failed to download Atuin theme (existing copy kept)"

# btop Catppuccin theme
echo "  Downloading btop Catppuccin Mocha theme..."
mkdir -p ~/.config/btop/themes
fetch_to ~/.config/btop/themes/catppuccin_mocha.theme \
    https://raw.githubusercontent.com/catppuccin/btop/main/themes/catppuccin_mocha.theme || \
    echo "    ⚠️  Failed to download btop theme (existing copy kept)"

# Install yazi packages from the tracked NAME list.
#
# What is tracked is `plugins.list` — the names — and NOT package.toml,
# which is the lockfile `ya pkg` rewrites with a rev and hash per plugin.
# The reason is that `ya pkg upgrade` runs from daily maintenance on every
# machine, so a tracked lockfile went dirty everywhere and the machines
# drifted apart: one had 3 of 13 pins moved and another had all 13, with
# neither able to see why from its own side.
#
# The trade-off is deliberate and worth stating: there is NO pinning, so
# every machine takes whatever upstream is current at install time, and a
# bad plugin release cannot be rolled back to a known-good rev from this
# repo. That is the intended behaviour here — maintenance runs often and
# the point is to be on the latest compatible version quickly.
#
# `ya pkg add` on a plugin already in package.toml prints
# "already exists" and changes nothing, so this is safe to re-run and
# also REBUILDS package.toml if it is missing — which it will be on the
# first pull that carries the untracking, and on any fresh machine.
if command -v ya &> /dev/null; then
    echo "📂 Installing yazi packages..."
    yazi_list="$HOME/.config/yazi/plugins.list"
    yazi_lock="$HOME/.config/yazi/package.toml"
    if [ -f "$yazi_list" ]; then
        # If the lockfile is missing or empty — which is the state on the
        # first pull that carries the untracking, and on a fresh machine —
        # any already-installed plugin dirs must go first. `ya pkg` stores
        # each plugin's hash IN package.toml, so without it every existing
        # dir looks modified and every `ya pkg add` aborts with "You have
        # modified the contents", leaving an EMPTY lockfile and no plugins
        # declared. Measured: 0 of 13 added with the dirs present, 13 of 13
        # after clearing. `add` has no --discard, so clearing is the only
        # route. The dirs are gitignored build artifacts and `ya pkg`
        # re-fetches them, so this costs a download, not any of your data.
        if ! grep -q '\[\[plugin.deps\]\]' "$yazi_lock" 2>/dev/null; then
            echo "  ↻ no yazi lockfile; clearing plugin artifacts so they can be re-fetched"
            rm -rf "$HOME/.config/yazi/plugins"
        fi
        while IFS= read -r pkg; do
            case "$pkg" in ''|\#*) continue ;; esac
            ya pkg add "$pkg" >/dev/null 2>&1 || true
        done < "$yazi_list"
    else
        echo "  ⚠️  $yazi_list missing; falling back to whatever package.toml holds"
    fi
    ya pkg install || echo "  ⚠️  Failed to install yazi packages"
else
    echo "  ⚠️  ya not found, skipping yazi package installation"
    echo "     Install yazi first, then re-run 'yadm bootstrap'"
fi

# Atuin daemon service: the tracked config enables daemon mode, so the
# launchd service must run on every machine or history writes go
# nowhere (the test suite asserts the socket is live). Idempotent.
if command -v atuin &> /dev/null && command -v brew &> /dev/null; then
    if grep -A6 '\[daemon\]' ~/.config/atuin/config.toml 2>/dev/null | grep -qE '^enabled = true'; then
        if ! brew services list 2>/dev/null | grep -qE '^atuin\s+started'; then
            echo "🚀 Starting atuin daemon service..."
            brew services start atuin >/dev/null 2>&1 || \
                echo "  ⚠️  Failed to start atuin service"
        fi
    fi
fi

# Install daily maintenance automation. That script has its own `set -e`
# and exits 1 on a missing prerequisite — swallow it so a failure there
# cannot kill the chmod/treesitter/test-suite tail of this bootstrap.
if [ -f "$HOME/install-daily-maintenance.sh" ]; then
    echo "🔧 Setting up daily maintenance automation..."
    bash "$HOME/install-daily-maintenance.sh" \
        || echo "  ⚠️  Daily maintenance install failed — run it manually"
fi

# Make all scripts executable
echo "🔐 Setting executable permissions..."
chmod +x ~/daily-maintenance*.sh 2>/dev/null || true
chmod +x ~/install-daily-maintenance.sh 2>/dev/null || true
chmod +x ~/uninstall-daily-maintenance.sh 2>/dev/null || true
chmod +x ~/test-dotfiles.sh 2>/dev/null || true
# Only the repo's own TRACKED scripts — never a blanket ~/.local/bin/*.
# The blanket form once chmod +x'd uv's sourceable 'env' PATH snippet,
# which then shadowed /usr/bin/env and silently swallowed every
# 'env ... cmd' invocation (the suite's env-shim test exists because
# of it, and caught this very line re-arming the trap).
if command -v yadm >/dev/null 2>&1; then
    yadm ls-files 2>/dev/null | grep '^\.local/bin/' | while IFS= read -r f; do
        chmod +x "$HOME/$f" 2>/dev/null || true
    done
fi

# Install essential treesitter parsers for Neovim
if command -v nvim &> /dev/null; then
    echo "🌲 Installing essential treesitter parsers..."
    # These parsers are required by noice.nvim and common development
    # vim, regex, lua, bash - required by noice.nvim cmdline
    # markdown, markdown_inline - required by noice.nvim for LSP docs
    # python, json, yaml, toml - common development languages
    # Use gtimeout (macOS) or timeout (Linux) if available
    TIMEOUT_CMD=""
    if command -v gtimeout &> /dev/null; then
        TIMEOUT_CMD="gtimeout 120"
    elif command -v timeout &> /dev/null; then
        TIMEOUT_CMD="timeout 120"
    fi
    $TIMEOUT_CMD nvim --headless \
        "+TSInstall vim regex lua bash markdown markdown_inline python json yaml toml" \
        "+sleep 20" +qa 2>/dev/null || echo "  ⚠️  Some parsers may need manual installation"
    echo "  ✓ Treesitter parsers installed"
fi

# SSH ControlMaster socket dir — 00-defaults.conf sets
# ControlPath ~/.ssh/sockets/%r@%h-%p but ssh never creates the
# directory itself; without it every connection fails with
# "unix_listener: cannot bind" (bit us live 2026-08-08).
mkdir -p "$HOME/.ssh/sockets" && chmod 700 "$HOME/.ssh/sockets"
echo "  ✓ ~/.ssh/sockets ready (ControlMaster)"

# Claude Code settings: the file is deliberately UNTRACKED (Claude Code
# rewrites it itself, and tracking published a personal model/plugin set
# from a public repo), so a fresh machine has no statusline, theme or
# hooks until this runs. It merges only the shared keys and leaves
# model/effortLevel/plugins alone.
if command -v jq >/dev/null 2>&1; then
    "$HOME/.local/bin/claude-settings-sync" || \
        echo "  ⚠️  claude-settings-sync failed — run it manually"
else
    echo "  ⚠️  jq missing; skipping claude-settings-sync"
fi

# Final self-verification: the suite encodes every cross-machine
# assumption (services, plugin sets, config schemas) — running it here
# turns "bootstrap finished" into "bootstrap verified".
echo "🧪 Running the test suite (final verification)..."
if bash ~/test-dotfiles.sh > /tmp/bootstrap-suite.log 2>&1; then
    echo "  ✓ Test suite green"
else
    echo "  ⚠️  Test suite reported failures — run: bash ~/test-dotfiles.sh"
fi

echo "✅ Bootstrap complete!"
echo ""
echo "📝 Next steps:"
echo "  1. Restart your terminal or run: source ~/.zshrc"
echo "  2. Open Neovim to verify LazyVim plugins are installed"
echo "  3. Check daily maintenance status: ~/daily-maintenance-control.sh status"