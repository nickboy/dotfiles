.DS_Store

# Git configuration (machine-specific)
.gitconfig

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Claude Code settings: TWO writers, so tracking it never held still —
# yadm on one side, Claude Code itself on the other (/model, /theme,
# /plugin rewrite it, hence the nested enabledPlugins and
# extraKnownMarketplaces nobody hand-writes). Tracking also published
# a personal model, effort level and plugin set to anyone cloning this
# PUBLIC repo. The shared half (statusLine, theme, our two hooks) is
# installed instead by ~/.local/bin/claude-settings-sync, which
# bootstrap runs — it merges only those keys and never touches the
# personal ones.
.claude/settings.json

# Per-machine statusline segment switches (see claude-statusline)
.config/claude-statusline/config.sh

# Machine-local shell overrides. On a work machine this holds corp paths
# and identity, so it must never be committed to this PUBLIC repo. Note
# status.showUntrackedFiles=no means an unignored file here would be
# INVISIBLE to `yadm status` while still stageable by `yadm add -A`.
.zshrc.local
.zshenv.local
.daily-maintenance.local

# Backup/snapshot copies of any of the above — same content, same risk
*.bak
*.bak-*
*.backup
*.orig

.bin/assets/corona
.config/vifm/vifminfo
vim/plugged/
vim/undodir/
git/gitconfig.local.symlink
Brewfile.lock.json

# Generated files from templates
Library/LaunchAgents/com.daily-maintenance.plist

# Neovim auto-generated files
.config/nvim/lazy-lock.json

# Yazi plugin CONTENTS are ya-pkg build artifacts — but package.toml is
# the tracked declaration (SHA-pinned deps; `ya pkg install` on new
# machines restores everything from it)
.config/yazi/plugins/*/
.config/yazi/flavors/*/

# Zellij WASM plugins (binary, install separately)
.config/zellij/plugins/*.wasm

# Atuin theme (downloaded by bootstrap)
.config/atuin/themes/

# btop theme (downloaded by bootstrap)
.config/btop/themes/
