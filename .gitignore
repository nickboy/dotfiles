.DS_Store

# Git configuration (machine-specific)
.gitconfig

# Claude Code local settings (machine-specific permissions)
.claude/settings.local.json

# Claude Code settings: TWO writers, so tracking it never held still —
# yadm on one side, Claude Code itself on the other (/model, /theme,
# /plugin rewrite it, hence the nested enabledPlugins and
# extraKnownMarketplaces nobody hand-writes). Tracking also published
# a personal model, effort level and plugin set to anyone cloning this
# PUBLIC repo. The shared half (statusLine, theme, our two hooks) is
# installed instead by ~/.local/bin/claude-settings-sync, which
# bootstrap runs — it merges only those keys and never touches the
# personal ones.
.claude/settings.json
# Every derivative too, anchored to the NAME rather than the extension:
# backups, editor swap files, .orig, .save. The `*.bak-*` rule below
# would only catch the shapes someone remembered to name that way, and
# a dot-separated backup (settings.json.bak.<ts>) matches neither it nor
# `*.bak`. That gap is not academic — status.showUntrackedFiles=no
# hides such a file from `yadm status` while `yadm add -A` still stages
# it, so one careless add publishes a personal model and plugin set.
.claude/settings.json.*

# Per-machine statusline segment switches (see claude-statusline)
.config/claude-statusline/config.sh

# Third-party BINARIES do not belong in a dotfiles repo. obsidian-cli was
# a 9.1 MB Mach-O universal build of someone else's project (Yakitrak),
# committed here — it is not ours to redistribute, it cannot run on the
# Linux work server, and Homebrew already provides it: the Brewfile
# installs its renamed successor `yakitrak/yakitrak/notesmd-cli`, and
# brew's own obsidian-cli is installed alongside. Tracking it only
# shadowed the package-managed copy with a frozen one.
.local/bin/obsidian-cli

# Machine-local Brewfile exclusions (see the header in ~/Brewfile)
.Brewfile.skip

# Machine-local shell overrides. On a work machine this holds corp paths
# and identity, so it must never be committed to this PUBLIC repo. Note
# status.showUntrackedFiles=no means an unignored file here would be
# INVISIBLE to `yadm status` while still stageable by `yadm add -A`.
.zshrc.local
.zshenv.local
.daily-maintenance.local

# Machine-local executables. Untracked AND unignored is the worst state here:
# status.showUntrackedFiles=no hides them from review while `yadm add -A`
# still stages them. herdr self-updates in place (an 18 MB binary that would
# be stale the moment it landed); dotfiles-upstream carries the work-marker
# list that is the whole point of the script, so it can never be public.
.local/bin/herdr
.local/bin/dotfiles-upstream

# ssh config.d is default-deny with an allowlist, so a new machine-local host
# block is ignored on creation rather than needing a rule each time. Only the
# two neutral files are shared: 00-defaults.conf, and the 1Password agent
# block. Everything else names a host, an employer, or overrides one of those
# two on a machine that cannot use it.
.ssh/config.d/*
!.ssh/config.d/00-defaults.conf
!.ssh/config.d/10-github-1password.conf

# Backup/snapshot copies of any of the above — same content, same risk
*.bak
*.bak-*
*.backup
*.orig

.bin/assets/corona
.config/vifm/vifminfo
vim/plugged/
vim/undodir/
git/gitconfig.local.symlink
Brewfile.lock.json

# Generated files from templates
Library/LaunchAgents/com.daily-maintenance.plist

# Neovim auto-generated files
.config/nvim/lazy-lock.json

# Yazi plugin CONTENTS are ya-pkg build artifacts — but package.toml is
# the tracked declaration (SHA-pinned deps; `ya pkg install` on new
# machines restores everything from it)
.config/yazi/plugins/*/
.config/yazi/flavors/*/
# ya pkg's LOCKFILE (rev + hash per plugin). `ya pkg upgrade` runs from
# daily maintenance on every machine, so tracking this made the same file
# go dirty everywhere and the machines drift apart. The tracked thing is
# .config/yazi/plugins.list — the NAMES — which bootstrap replays with
# `ya pkg add`. No pinning by design: every machine takes what upstream
# has at install time.
.config/yazi/package.toml

# Zellij WASM plugins (binary, install separately)
.config/zellij/plugins/*.wasm

# Atuin theme (downloaded by bootstrap)
.config/atuin/themes/

# btop theme (downloaded by bootstrap)
.config/btop/themes/
